# Copie para `.env` e preencha. O `.env` nunca é versionado.

# --- Banco -------------------------------------------------------------------
# Opcional. Sem esta variável o servidor sobe em memória: a conversa funciona
# ponta a ponta, mas o histórico morre quando o processo reinicia.
#
# O Prisma exige replica set para MongoDB. O Atlas já vem configurado; num
# Mongo local é preciso criar um replica set, ainda que de um nó só.
#
# Atlas:
#   DATABASE_URL="mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/alan?retryWrites=true&w=majority"
#
# Replica set auto-hospedado (liste todos os nós para o driver fazer failover):
#   DATABASE_URL="mongodb://USUARIO:SENHA@host-1:27017,host-2:27017,host-3:27017/alan?replicaSet=rs0&authSource=admin"
DATABASE_URL=""

# --- Modelo ------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Servidor ----------------------------------------------------------------
PORT="3001"

# --- Canal n8n (conversa + memória em níveis) ---------------------------------
# Com N8N_CHAT_WEBHOOK_URL o servidor vira relé SSE para o n8n: o workflow
# `alan/chat` conversa com o ChatGPT e devolve os tokens em streaming.
# Sem esta variável a conversa é direta com o modelo (openai acima).
#
# N8N_CLASSIFY_WEBHOOK_URL aponta o workflow `alan/classify`, que decide o
# nível de memória de cada conversa nova:
#   1 = stateless (nada é gravado) · 2 = Redis com TTL · 3 = MongoDB
# Sem esta variável, toda conversa é stateless.
#
# N8N_WEBHOOK_SECRET é enviado como `Authorization: Bearer <secret>` nas duas
# chamadas; confira-o nos workflows (nó de validação de cabeçalho).
# N8N_CHAT_WEBHOOK_URL="http://127.0.0.1:5678/webhook/alan/chat"
# N8N_CLASSIFY_WEBHOOK_URL="http://127.0.0.1:5678/webhook/alan/classify"
# N8N_WEBHOOK_SECRET=""

# --- Memória de nível 2 (Redis) ------------------------------------------------
# Ausente = nível 2 degrada para stateless (com aviso no /api/health).
# REDIS_URL="redis://127.0.0.1:6379"
# REDIS_TTL="86400"  # 24h em segundos
